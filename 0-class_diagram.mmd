classDiagram
    class Library {
        +add_book()
        +register_user()
        +create_loan()
    }

    class Book {
        +str title
        +str author
        +bool state
        +mark_as_unavailable()
        +mark_as_available()
    }

    class User {
        +str name
        +str email
    }

    class Loan {
        +str start_date
        +str end_date
        +close_loan()
    }

    Library "1" o-- "*" Book : manages
    Library "1" o-- "*" User : registers
    Library "1" o-- "*" Loan : creates
    User "1" -- "*" Loan : has
    Book "1" -- "*" Loan : associated with
